{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@src/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": []
}
